{
  "name": "govdata-insights",
  "private": true,
  "workspaces": [
    "backend",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently -n api,dash -c blue,green \"npm run dev:backend\" \"npm run dev:dashboard\"",
    "dev:backend": "npm run dev -w backend",
    "dev:dashboard": "npm run dev -w dashboard",
    "build": "npm run build -w backend && npm run build -w dashboard",
    "db:generate": "npm run db:generate -w backend",
    "db:push": "npm run db:push -w backend",
    "etl": "npm run etl -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
